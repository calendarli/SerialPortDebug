<Project>
  <!-- CI opts into pinned NuGet kits; local builds keep using their installed WDK. -->
  <ImportGroup Condition="'$(SERIALFLOW_WDK_PACKAGES)' != ''">
    <Import Project="$(SERIALFLOW_WDK_PACKAGES)\Microsoft.Windows.WDK.x64.10.0.26100.6584\build\native\Microsoft.Windows.WDK.x64.props" />
    <Import Project="$(SERIALFLOW_WDK_PACKAGES)\Microsoft.Windows.SDK.CPP.x64.10.0.26100.6584\build\native\Microsoft.Windows.SDK.cpp.x64.props" />
    <Import Project="$(SERIALFLOW_WDK_PACKAGES)\Microsoft.Windows.SDK.CPP.10.0.26100.6584\build\native\Microsoft.Windows.SDK.cpp.props" />
  </ImportGroup>
</Project>
